# คัดลอกไฟล์นี้เป็น ".env" แล้วแก้ค่าให้เป็นของจริง
# ไฟล์ .env ถูก .gitignore ไว้ — ห้าม commit ขึ้น repo

# PROMPTPAY_ID — เลขพร้อมเพย์ของร้าน (เลือกอย่างใดอย่างหนึ่ง)
#   เบอร์มือถือ 10 หลัก ขึ้นต้นด้วย 0  (PROMPTPAY_ID_TYPE=phone)
#   บัตรประชาชน 13 หลัก              (PROMPTPAY_ID_TYPE=citizen)
#   e-Wallet 15 หลัก                   (PROMPTPAY_ID_TYPE=wallet)
# ค่าด้านล่างเป็นตัวอย่างที่ใช้ไม่ได้จริง — ต้องแก้ก่อนใช้งาน
PROMPTPAY_ID=0000000000
PROMPTPAY_ID_TYPE=phone

# ชื่อผู้ถือบัญชีที่แสดงใต้ QR (ถ้าเว้นว่างจะใช้ merchant_name จาก billing_data.json)
PROMPTPAY_ACCOUNT_NAME=NICHE BLOOMS
